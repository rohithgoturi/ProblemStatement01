# ==============================================================================
# PragatiPath Backend Environment Configuration Template (.env.example)
# Copy this file to .env and configure the respective values
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/PragatiPath?retryWrites=true&w=majority

# LLM AI Provider Configuration (Google Gemini API for Unstructured Progress Extraction)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# JWT Secret for Session & RBAC Authentication
JWT_SECRET=your_cryptographically_secure_jwt_secret_here

# Transactional Email Service Configuration (Nodemailer SMTP)
# Used for welcome notifications and secure cryptographic password recovery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=pragatipath6@gmail.com
EMAIL_PASSWORD=your_google_app_password_here
EMAIL_FROM="PragatiPath <pragatipath6@gmail.com>"
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=60
