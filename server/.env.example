# ==============================================================================
# PragatiPath Backend Environment Configuration Template (.env.example)
# Copy this file to .env and configure the respective values for your deployment
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Frontend Application URLs (Used for CORS and email links)
# Production example: https://app.pragatipath.com
# Local development:  http://localhost:5173
CLIENT_URL=https://app.pragatipath.com
FRONTEND_URL=https://app.pragatipath.com

# MongoDB Connection String (MongoDB Atlas Cluster or self-hosted)
# Production example: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/PragatiPath?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/PragatiPath?retryWrites=true&w=majority

# JWT Cryptographic Secret (Required in production - minimum 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_and_paste_a_secure_64_character_hex_secret_here

# LLM AI Provider Configuration (Google Gemini API for Natural Language Progress Extraction)
# Free/Pay-as-you-go API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Transactional Email Service Configuration (Nodemailer SMTP)
# Used for welcome notifications and secure cryptographic password recovery
# Providers: Gmail App Password, SendGrid, Postmark, AWS SES, Resend SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@yourdomain.com
EMAIL_PASSWORD=your_smtp_app_password_here
EMAIL_FROM="PragatiPath <notifications@yourdomain.com>"
PASSWORD_RESET_EXPIRES_MINUTES=60
